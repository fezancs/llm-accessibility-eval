.env
.venv/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
data/e3/images/
data/corpus/tmp/
runs/**/raw/
runs/**/workspaces/
runs/**/screens/
# Re-creatable caches: the response cache (resumability on this machine; raw responses
# are kept under runs/<exp>/raw/) and the evaluation cache (recomputed from artifacts).
runs/cache/
runs/**/evalcache/
runs_*.log
# machine-specific symlinks to data/corpus/base/images (common.link_images), and E1-Repair
# reference copies + screenshots of corpus pages (re-created from data/corpus when scoring)
runs/**/artifacts/**/images
runs/**/artifacts/repair_refs/
runs/local_pipeline/.server
runs/local_pipeline/.launching
